---
import Layout from "../layouts/Layout.astro";
import PortadaName from "../components/portada/portada-name.jsx";
import SideWorksPage from "../components/side-works/side-works-page.astro";
import AboutMe from "../components/about-me/about-me.astro";
import HorizontalSection from "../components/about-me/horizontal-section.astro";
import Memoji from "../components/memoji.astro";
import OriginalAboutMe from "../components/AboutMe.astro";
import Bento from "../components/Bento.astro";
import Contact from "../components/Contact.astro";
import Experience from "../components/Experience.astro";
import Footer from "../components/Footer.astro";
import Focus from "../components/Focus.astro";
// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<div class="portada">
		<PortadaName client:only="react" />
	</div>
	<AboutMe />
	<section class="portfolio-details">
		<Experience />
		<OriginalAboutMe />
		<Bento />
		<Focus />
		<Contact />
		<Footer />
	</section>
	<Memoji />
	<!--  -->
	<!-- <HorizontalSection client:load /> -->
	<!-- <SideWorksPage /> -->
</Layout>

<style>
	.portada {
		min-height: 100svh;
		display: flex;
		justify-content: center;
		align-items: center;
		box-sizing: border-box;
		padding: 2rem clamp(1rem, 5vw, 4rem);
	}

	.portfolio-details {
		display: flex;
		flex-direction: column;
		gap: 90px;
		padding-block: 90px;
	}

	@media (max-width: 768px) {
		.portada {
			min-height: 100dvh;
			padding-block: 3rem 2rem;
		}

		.portfolio-details {
			gap: 20px;
			padding-block: 20px;
		}
	}
</style>
